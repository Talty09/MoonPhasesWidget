<Window x:Class="MoonPhasesWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MoonPhasesWidget.Controls"
        Title="Moon Phase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="Panel" CornerRadius="16" Background="#E0141821" Padding="20,18,20,16">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on top" IsCheckable="True" Click="AlwaysOnTop_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Width="150">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="Foreground" Value="#B8BFCC" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </StackPanel.Resources>

            <controls:MoonDisc x:Name="Moon" Width="110" Height="110" Margin="0,0,0,14">
                <controls:MoonDisc.Effect>
                    <DropShadowEffect x:Name="MoonGlow" ShadowDepth="0" BlurRadius="22" Color="#F5E9C8" Opacity="0.4" />
                </controls:MoonDisc.Effect>
            </controls:MoonDisc>

            <TextBlock x:Name="PhaseNameText" FontSize="16" FontWeight="SemiBold" Foreground="#F2F2F2" />
            <TextBlock x:Name="IlluminationText" Margin="0,2,0,10" />
            <TextBlock x:Name="NextEventText" />
            <TextBlock x:Name="FollowingEventText" />
        </StackPanel>
    </Border>
</Window>
